# SPDX-License-Identifier: AGPL-3.0-or-later
# Hostashi agent: runs as root, listens only on a Unix socket and executes
# only the typed operations in internal/agentapi.
#
# It cannot use ProtectSystem or ProtectHome: creating a site writes
# /etc/passwd and /etc/group (useradd) and the home below /home or a pool.
# nginx -t (run by the agent before every switch) creates IPv4 and IPv6
# sockets for the listen addresses without binding them, so AF_INET and
# AF_INET6 are allowed. IPAddressDeny=any still blocks every packet: the
# checks after a reload go through nginx's Unix control socket.

[Unit]
Description=Hostashi agent (privileged, typed operations only)
Documentation=https://github.com/maki-it/hostashi
After=local-fs.target
Before=hostashi.service

[Service]
# No core dumps: they would hold keys, passwords and session data (ADR-0033).
LimitCORE=0
Type=simple
# HOSTASHI_PANEL_PORT: HTTPS port of the panel's own address (ADR-0023).
Environment=HOSTASHI_PANEL_PORT=8443
EnvironmentFile=-/etc/hostashi/hostashi.env
ExecStart=/usr/local/bin/hostashi agent -serve-user hostashi -socket /run/hostashi/agent.sock -state-dir /var/lib/hostashi-agent "-panel-port=${HOSTASHI_PANEL_PORT}"
# root:root 0750; the agent gives the group to the serve user at start.
RuntimeDirectory=hostashi
RuntimeDirectoryMode=0750
StateDirectory=hostashi-agent
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=no
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
# No RestrictSUIDSGID=: systemd enforces it by making openat2() fail with
# ENOSYS, and the agent needs openat2 for every path it touches (spike S4).
# Found in the container test of the installer.
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The capabilities the agent and the tools it starts need (ADR-0033):
# - CHOWN, DAC_*, FOWNER, FSETID: homes, configuration files and restores
#   owned by the sites' users;
# - SETUID, SETGID: useradd and userdel, files written as a site's user;
# - KILL: processes of a site that is deleted;
# - SYS_ADMIN, SYS_RESOURCE: project quotas (quotactl_fd, FS_IOC_FSSETXATTR);
# - SYS_PTRACE: /proc of the sites' processes, hidden by hidepid=invisible;
# - AUDIT_WRITE: useradd and userdel write audit records;
# - NET_BIND_SERVICE: nginx -t opens the listening sockets of ports 80 and
#   443 to test them (found in the container test).
# Gone are, among others, network administration, raw I/O, modules, the
# clock, reboot, mknod, chroot and setting file capabilities.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_AUDIT_WRITE CAP_NET_BIND_SERVICE
# The usual system calls of a service plus the quota calls.
SystemCallFilter=@system-service quotactl quotactl_fd
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
