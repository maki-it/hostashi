# Installs (%i = install) or removes (%i = remove) ClamAV from the
# distribution for the malware scan (ADR-0064). The agent starts an
# instance when an admin switches the scan on or off; the script accepts
# only these two words, so the instance name cannot pick a package. It runs
# apt and the packages' maintainer scripts, so it needs root and a writable
# system: no ProtectSystem here, as for hostashi-php-install@.service.

[Unit]
Description=ClamAV %i for Hostashi
Documentation=https://github.com/maki-it/hostashi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/hostashi/clamav-install %i
TimeoutStartSec=15min
# No core dumps (ADR-0033).
LimitCORE=0
PrivateTmp=yes
# The agent reads this log for the panel (scan.engine.status); the
# installer creates the directory.
StandardOutput=truncate:/var/lib/hostashi-agent/clamav-install/install.log
StandardError=inherit
SyslogIdentifier=hostashi-clamav-install
