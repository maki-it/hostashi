// Managed by Hostashi (ADR-0033); the installer overwrites changes.
// Security updates of the distribution are installed every day, nothing
// else: no point releases, no third-party sources. The server never
// reboots by itself; `hostashi doctor` reports when a reboot is needed.
// This file sorts after the package's 20auto-upgrades and
// 50unattended-upgrades, so its values win and the #clear lines drop the
// package's origin lists.

APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";

#clear Unattended-Upgrade::Allowed-Origins;
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
@ORIGINS@
};

Unattended-Upgrade::Automatic-Reboot "false";
Unattended-Upgrade::Remove-Unused-Dependencies "false";
