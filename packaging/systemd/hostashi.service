# Hostashi panel (web UI and API). Runs as the unprivileged user hostashi
# and reaches the agent only through /run/hostashi/agent.sock.
#
# /etc/hostashi/hostashi.env sets HOSTASHI_LISTEN and HOSTASHI_PUBLIC_URL
# (written by the installer). The panel listens on loopback only (SSH
# tunnel, health check). nginx serves it over HTTPS on the panel port of
# the public URL and reaches it through hostashi-panel.socket (ADR-0023).
#
# Site certificates come from HOSTASHI_ACME_DIRECTORY (Let's Encrypt by
# default; empty turns certificates off). HOSTASHI_ACME_CA names an extra
# CA file for a test CA such as Pebble.
#
# HOSTASHI_METRICS_LISTEN (empty by default) opens a loopback listener that
# serves /metrics without a token for a scraper on this host, for example
# 127.0.0.1:9471 (ADR-0022). Every local user can reach it, so leave it
# empty on hosts with untrusted site users and scrape with a metrics:read
# token instead. Metrics must also be switched on in the panel settings.

[Unit]
Description=Hostashi panel (web UI and API, no root)
Documentation=https://github.com/maki-it/hostashi
After=network.target hostashi-agent.service hostashi-panel.socket
Wants=hostashi-agent.service
Requires=hostashi-panel.socket

[Service]
# No core dumps: they would hold keys, passwords and session data (ADR-0033).
LimitCORE=0
Type=simple
Sockets=hostashi-panel.socket
User=hostashi
Group=hostashi
Environment=HOSTASHI_LISTEN=127.0.0.1:8080 HOSTASHI_PUBLIC_URL=
Environment=HOSTASHI_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory HOSTASHI_ACME_CA=
Environment=HOSTASHI_METRICS_LISTEN=
# The web database tool (ADR-0038); the installer sets 8444, 0 is off.
Environment=HOSTASHI_DB_TOOL_PORT=0
EnvironmentFile=-/etc/hostashi/hostashi.env
ExecStart=/usr/bin/hostashi serve "-listen=${HOSTASHI_LISTEN}" "-public-url=${HOSTASHI_PUBLIC_URL}" -db /var/lib/hostashi/hostashi.db -key /etc/hostashi/secret.key -socket /run/hostashi/agent.sock "-acme-directory=${HOSTASHI_ACME_DIRECTORY}" "-acme-ca=${HOSTASHI_ACME_CA}" "-metrics-listen=${HOSTASHI_METRICS_LISTEN}" "-db-tool-port=${HOSTASHI_DB_TOOL_PORT}"
UMask=0077
Restart=on-failure
RestartSec=2s

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/hostashi /var/lib/hostashi-acme/.well-known/acme-challenge
ReadOnlyPaths=/etc/hostashi
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
