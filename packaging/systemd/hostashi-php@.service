# Template for the PHP-FPM master of one site (ADR-0015, ADR-0019). The
# installer writes one copy per PHP version as hostashi-php-<version>@.service
# and replaces @VERSION@; the agent starts hostashi-php-<version>@<site>.
#
# The master runs as root only to open the socket for the web server group
# and to drop its workers to the site user (pool file, rendered by the agent
# under /var/lib/hostashi-agent/php). The pool file is the same for every
# version, so a site switches versions by stopping one unit and starting
# another.

[Unit]
Description=PHP @VERSION@ FastCGI for Hostashi site %i
Documentation=https://github.com/maki-it/hostashi
After=network.target
ConditionPathExists=/var/lib/hostashi-agent/php/%i.conf

[Service]
# No core dumps: they would hold keys, passwords and session data (ADR-0033).
LimitCORE=0
Type=notify
ExecStart=/usr/sbin/php-fpm@VERSION@ --nodaemonize --fpm-config /var/lib/hostashi-agent/php/%i.conf
ExecReload=/bin/kill -USR2 $MAINPID
# /run/hostashi-php/<site>: root 0755; the socket in it is <site>:www-data 0660.
RuntimeDirectory=hostashi-php/%i
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2s

# A /tmp of its own: uploads, sessions and temp files of one site stay
# invisible to the others (open_basedir includes /tmp).
PrivateTmp=yes
PrivateDevices=yes
# The system is read only and /home is empty: the agent's drop-in
# (50-hostashi-slice.conf) mounts the site's own home back, writable, so the
# master never sees another site's home (ADR-0033).
ProtectSystem=strict
ProtectHome=tmpfs
# The master needs root only to drop its workers to the site user, to give
# the socket to the site user and the web server group, and to stop its
# workers. Everything else root could do is gone.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_KILL
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# The usual system calls of a service: no mount, module, reboot, swap,
# clock, raw I/O or debugging calls, for the master and the site's code.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Other users' processes are hidden in /proc. No ProcSubset=pid: PHP reads
# /proc/loadavg and /proc/meminfo, for example in sys_getloadavg().
ProtectProc=invisible
# No UMask=0027: files the site's code writes must stay readable for the
# web server, which serves uploads directly.
# No MemoryDenyWriteExecute=: it breaks the opcache JIT and PCRE's JIT.

[Install]
WantedBy=multi-user.target
