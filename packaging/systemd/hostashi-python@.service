# Template for the Python app of one site (ADR-0061). The agent starts
# hostashi-python@<site> and writes two drop-ins for it, as for
# hostashi-node@: 50-hostashi-slice.conf puts the unit into the site's
# slice and mounts the site's own home back, and 60-hostashi-app.conf sets
# WorkingDirectory=, ExecStart= (<home>/.venv/bin/python with gunicorn,
# uvicorn or a .py file, the address 127.0.0.1:<port> and the extra
# arguments, each quoted by the agent) and the environment, all from typed
# values the agent checked. The app is the site's own code and runs as the
# site user, like its PHP. The sandbox is the one of hostashi-node@, kept
# the same on purpose.

[Unit]
Description=Python app of Hostashi site %i
Documentation=https://github.com/maki-it/hostashi
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=%i
Group=%i
# Replaced by the drop-in.
ExecStart=/bin/false
Restart=on-failure
RestartSec=2s
TimeoutStopSec=20s
# No core dumps: they would hold keys, passwords and session data (ADR-0033).
LimitCORE=0
# The app's output, opened by systemd as root before the app starts: the
# site user can neither open nor change it; the panel reads it through
# the agent (ADR-0053). The agent creates the directory.
StandardOutput=append:/var/log/hostashi/app/%i/app.log
StandardError=inherit
SyslogIdentifier=hostashi-python-%i

# A /tmp of its own.
PrivateTmp=yes
PrivateDevices=yes
# The system is read only and /home is empty: the drop-in mounts the
# site's own home back, writable (ADR-0033).
ProtectSystem=strict
ProtectHome=tmpfs
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Other users' processes are hidden in /proc.
ProtectProc=invisible
RemoveIPC=yes
# No MemoryDenyWriteExecute=: cffi and ctypes callbacks can need writable
# executable memory (ADR-0061).

[Install]
WantedBy=multi-user.target
