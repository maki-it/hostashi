# SPDX-License-Identifier: AGPL-3.0-or-later
# Installs the pinned Node.js build of LTS line %i (ADR-0054). The agent
# starts an instance when an admin installs a line in the panel. The binary
# checks %i against its own list (agentapi.NodeReleases), downloads the
# .tar.gz from nodejs.org, checks its SHA-256 against the pinned value and
# unpacks it into /opt/hostashi/node/%i. Nothing it downloads is run.
#
# It needs the network (nodejs.org) but no capability: root owns
# /opt/hostashi/node, and the files it writes stay root's and read-only
# for the site users.

[Unit]
Description=Install Node.js %i for Hostashi
Documentation=https://github.com/maki-it/hostashi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/hostashi node-install %i
TimeoutStartSec=15min
# No core dumps (ADR-0033).
LimitCORE=0
# The agent reads this log for the panel (node.status); the installer
# creates the directory.
StandardOutput=truncate:/var/lib/hostashi-agent/node-install/%i.log
StandardError=inherit
UMask=0022

ReadWritePaths=/opt/hostashi/node
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
# No RestrictSUIDSGID=: it makes openat2() fail with ENOSYS (os.Root).
# The unpacker sets no setuid or setgid bit itself.
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=yes
PrivateIPC=yes
