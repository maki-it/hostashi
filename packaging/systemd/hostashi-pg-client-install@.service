# Installs the PostgreSQL client tools of major %i from apt.postgresql.org
# (ADR-0051). The agent starts an instance when the panel needs the client
# for an external PostgreSQL server; the script checks %i against its own
# allowlist, so the instance name cannot pick a package. It runs apt and
# the packages' maintainer scripts, so it needs root and a writable system:
# no ProtectSystem here, as for hostashi-php-install@.service.

[Unit]
Description=Install the PostgreSQL %i client tools for Hostashi
Documentation=https://github.com/maki-it/hostashi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/hostashi/pg-client-install install %i
TimeoutStartSec=15min
# No core dumps (ADR-0033).
LimitCORE=0
PrivateTmp=yes
# The agent reads this log for the panel (pg.client.status); the
# installer creates the directory.
StandardOutput=truncate:/var/lib/hostashi-agent/pg-client-install/%i.log
StandardError=inherit
